# Dépendances
node_modules/

# Sorties de compilation : `npm run build` les régénère
dist/
*.tsbuildinfo

# Déclaration MCP locale : chemins absolus propres à chaque machine,
# régénérée par `harness init`
.mcp.json

# État runtime du harness. Il vit normalement dans ~/.midgaard ;
# ces entrées couvrent un MIDGAARD_HOME pointé dans le dépôt.
.midgaard/
.runtime*/

# Système
.DS_Store
