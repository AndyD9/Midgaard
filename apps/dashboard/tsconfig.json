{
  "$comment": "Configuration propre au dashboard : cible navigateur, JSX React, aucun émit (c'est Vite qui compile).",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // Les types de `@midgaard/contracts` sont lus directement dans ses sources
    // (condition d'export "types"), qui s'importent entre elles avec l'extension
    // `.ts`. Sans émit ici, c'est sans conséquence : Vite ne voit que des imports
    // de types, effacés à la compilation.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
